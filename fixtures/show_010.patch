+fn my_as_24_bit_terminal_escaped(v: &[(Style, &str)], bg: bool) -> String {
+    let mut s: String = String::new();
+    for &(ref style, text) in v.iter() {
+        if bg {
+            write!(s,
+                   "\x1b[48;2;{};{};{}m",
+                   style.background.r,
+                   style.background.g,
+                   style.background.b)
+                .unwrap();
+        }
+        write!(s,
+               "\x1b[38;2;{};{};{}m{}",
+               style.foreground.r,
+               style.foreground.g,
+               style.foreground.b,
+               text)
+            .unwrap();
+    }
+    // s.push_str("\x1b[0m");
+    s
